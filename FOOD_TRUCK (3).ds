 application "FOOD TRUCK"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Cash_Reconciliation
		{
			displayname = "Cash Reconciliation"
			success message = "Cash Reconciliation Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Shift_Reference
			(
				type = picklist	
				displayname = "Shift Reference."
				values  = Daily_Shift_Log.ID
    			displayformat = [Shift_Date]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Opening_Cash
			(
				displayname = "Opening Cash"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Card_Sales
			(
				displayname = "Card Sales"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Actual_Cash_Counted
			(
				displayname = "Actual Cash Counted"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cash_Variance
			(
				type = decimal
				displayname = "Cash Variance"
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Actual_Cash_Counted - input.Opening_Cash
    						visibility = false
    			)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Daily_Shift_Log
		{
			displayname = "Daily Shift Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Shift_Date
			(
    			type = date
				displayname = "Shift Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Shift_Type
			(
				type = picklist
				displayname = "Shift Type"
				maxchar = 100
				values = {"Lunch","Event","Dinner"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Location
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Operator_Name
			(
    			type = text
				displayname = "Operator Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inventory_Subform
			(
				type = grid
				displayname = "Inventory Subform"
				Items_Master
				(
					type = picklist	
					displayname = "Items Master"
					values  = Items_Master.ID
    				displayformat = [Item_name]
					sortorder = ascending
					width = medium
				)
				Opening_Qty
				(
					type = decimal
					displayname = "Opening Qty"
					width = medium
				)
				Closing_Qty
				(
					type = decimal
					displayname = "Closing Qty"
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Items_Master
		{
			displayname = "Items Master"
			success message = "Items Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Item_name
			(
    			type = text
				displayname = "Item name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category
			(
				type = picklist
				maxchar = 100
				values = {"Ingredients","Beverages","Packaging/Supplies"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unit_of_Measure
			(
				type = picklist
				displayname = "Unit of Measure"
				maxchar = 100
				values = {"kg","lbs","liters"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cost_Price
			(
				displayname = "Cost Price"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Minimum_Reorder_Level
			(
				type = number
				displayname = "Minimum Reorder Level"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Menu_Items
		{
			displayname = "Menu Items"
			success message = "Menu Item Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Menu_Item_Name
			(
    			type = text
				displayname = "Menu Item Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Selling_Price
			(
				displayname = "Selling Price"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category
			(
				type = picklist
				maxchar = 100
				values = {"food","drink","combo"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Items_Masters
		{
			displayName = "All Items Masters"
			show all rows from Items_Master    
			(
				Item_name as "Item name"
				Category
				Unit_of_Measure as "Unit of Measure"
				Cost_Price as "Cost Price"
				Minimum_Reorder_Level as "Minimum Reorder Level"
			)
		}
		default list All_Menu_Items
		{
			displayName = "All Menu Items"
			show all rows from Menu_Items    
			(
				Menu_Item_Name as "Menu Item Name"
				Selling_Price as "Selling Price"
				Category
			)
		}
		default list Daily_Shift_Log_Report
		{
			displayName = "Daily Shift Log Report"
			show all rows from Daily_Shift_Log    
			(
				Shift_Date as "Shift Date"
				Shift_Type as "Shift Type"
				Location
				Operator_Name as "Operator Name"
				Inventory_Subform.Opening_Qty as "Inventory Subform"
			)
		}
		default list All_Cash_Reconciliations
		{
			displayName = "All Cash Reconciliations"
			show all rows from Cash_Reconciliation    
			(
				Shift_Reference as "Shift Reference."
				Opening_Cash as "Opening Cash"
				Card_Sales as "Card Sales"
				Actual_Cash_Counted as "Actual Cash Counted"
				Cash_Variance as "Cash Variance"
			)
		}
		list Low_Stock_Report
		{
			displayName = "Low Stock Report"
			show all rows from Items_Master  [Minimum_Reorder_Level >= 10]  
			(
				Item_name as "Item name"
				Category
				Unit_of_Measure as "Unit of Measure"
				Cost_Price as "Cost Price"
				Minimum_Reorder_Level as "Minimum Reorder Level"
			)
		}
	}
	pages
	{
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n\t\n\ttitle = 'Low Stock Items'\n\t\n\t\ttitleColor = '#222326'\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\n\tcolor = '#FFFFFF'\n\tbgColor = '#0ABB51'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'media-1-ticket-76'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#0ABB51'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#0ABB51'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Inventory_Subform.Closing_Qty &lt;= 10'\n\t  value = 'thisapp.Daily_Shift_Log.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '0px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '17px'\n\tpaddingBottom = '17px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Low Stock Items'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Pie'\n\txtitle = 'Item Name'\n\tytitle = 'Minimum Stock Level'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Items_Master'\n\txfield = 'Item_name'\n\tyfields = 'sum:Minimum_Reorder_Level'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Items_Masters'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Low_Stock_Alert as "Low Stock Alert"
			{
				type =  form
				form = Daily_Shift_Log

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "jaitha.k.2024.cse@rajalakshmi.edu.in"
							to : "jaitha.k.2024.cse@rajalakshmi.edu.in"
							subject : "Record Added or Updated ALERT: Low Stock Detected"
							message : "<div>${zoho.loginuserid} has added or updated a record in form Daily Shift Log<br></div><div><br></div><div><br></div><div>A shift log was submitted with low stock items. Please review and reorder as necessary.<br></div>"
						)
					}
				}

			}
			Low_Stock_Alert1 as "Low Stock Alert"
			{
				type =  form
				form = Items_Master

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.loginuserid"
							to : "jaitha.k.2024.cse@rajalakshmi.edu.in"
							subject : "Record Added or Updated  Low Stock Alert: ${Item_Name}"
							message : "<div>${zoho.loginuserid} has added or updated a record in form Items Master<br></div>"
						)
					}
				}

			}
			Auto_populate_Opening_Qty as "Auto-populate Opening Qty"
			{
				type =  form
				form = Daily_Shift_Log

				record event = on add or edit

				on user input of Inventory_Subform.Items_Master
				{
					actions 
					{
						custom deluge script
						(
											if(row.Items_Master != null)
										{
											// 1. Try to find the last shift log entry
											last_shift = Daily_Shift_Log[Inventory_Subform.Items_Master == row.Items_Master] sort by Shift_Date desc;
											if(last_shift.count() > 0)
											{
												for each  prev_row in last_shift.Inventory_Subform
												{
													if(prev_row.Items_Master == row.Items_Master)
													{
														row.Opening_Qty=prev_row.Closing_Qty;
													}
												}
											}
											else
											{
												// 2. Fallback: If no shift logs exist, fetch from Items Master
												item_rec = Items_Master[ID == row.Items_Master];
												row.Opening_Qty=item_rec.Minimum_Reorder_Level;
											}
										}
						)
					}
				}

			}
		}






	}
