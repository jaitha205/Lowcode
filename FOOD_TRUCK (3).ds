					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab,read_comm,write_comm,create_new_report 
						allFieldsVisible= true 
						ReportPermissions
						{
							Daily_Shift_Log_Report={"View","Edit","Delete"}
						}
					}
					Items_Master
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab,read_comm,write_comm,create_new_report 
						allFieldsVisible= true 
